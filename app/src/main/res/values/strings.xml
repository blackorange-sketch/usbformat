    <string name="refresh">Refresh</string>

    <string name="section_scheme">Partition scheme</string>
    <string name="scheme_hint">MBR: best compatibility (TVs, car stereos, older PCs). GPT: drives over 2 TiB and modern UEFI PCs.</string>

    <string name="section_fs">File system</string>
    <string name="fs_fat32_hint">Works almost everywhere. Files up to 4 GiB.</string>
    <string name="fs_exfat_hint">No practical file size limit. Needs Windows 7 or newer, macOS, Linux or a recent Android.</string>
    <string name="fs_ntfs_hint">NTFS is not available yet.</string>

    <string name="section_erase">Erase</string>
    <string name="erase_quick">Quick</string>
    <string name="erase_zero">Full (zeros)</string>
    <string name="erase_verify">Full + test</string>
    <string name="erase_quick_hint">Rewrites the partition table and file system. Takes seconds.</string>
    <string name="erase_zero_hint">Also overwrites the whole drive with zeros. Large drives can take hours.</string>
    <string name="erase_verify_hint">Writes a test pattern to the whole drive and reads it back to find bad blocks and fake capacity. Slowest.</string>

